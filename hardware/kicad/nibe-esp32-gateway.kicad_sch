	)
	(text "Terminal J2 follows the NIBE MODBUS 40 order:\nJ2.1 12V <- AA3-X4:12   J2.2 A <- X4:11\nJ2.3 B <- X4:10         J2.4 GND <- X4:9"
		(exclude_from_sim no)
		(at 20.32 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "29c16a5b-763c-564a-9161-1b5be46438f8")
	)
	(text "JP1 is closed by default (120 ohm termination on).\nCut it if another device sits after this board.\nR9/R10 bias the idle bus, as on the LilyGo T-CAN485."
		(exclude_from_sim no)
		(at 20.32 233.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "63363b7f-4bfe-5664-8481-20a0d692d49a")
	)
	(text "U4 EN is left open: the TPS62933 starts when EN floats.\nRT tied to GND sets 1.2 MHz. Vout = 0.8 V x (1 + R3/R4) = 3.31 V."
		(exclude_from_sim no)
		(at 132.08 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "834c8a4a-271f-5f11-a527-68e7bb259210")
	)
	(text "D1/D2 let USB and the heat pump feed the board at the same\ntime without back-feeding each other."
		(exclude_from_sim no)
		(at 99.06 63.5 0)
		(effects
